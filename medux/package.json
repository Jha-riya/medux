{
  "name": "medux",
  "private": true,
  "version": "0.0.0",
  "type": "module",

  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:all": "npm run build --workspace=packages/media-core && npm run build --workspace=packages/media-react && npm run build --workspace=packages/media-native && npm run build --workspace=packages/media-ui-react && npm run build --workspace=packages/media-ui-native",
    "lint": "oxlint",
    "preview": "vite preview --workspace=apps/web",
    "test:smoke": "npm run test:smoke --workspace=packages/media-core"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
